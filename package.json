{
  "name": "agent-org",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n shared,server,web -c gray,cyan,magenta \"npm:dev:shared\" \"npm:dev:server\" \"npm:dev:web\"",
    "dev:shared": "npm run dev -w @agent-org/shared",
    "dev:server": "npm run dev -w @agent-org/server",
    "dev:web": "npm run dev -w @agent-org/web",
    "build": "npm run build -w @agent-org/shared && npm run build -w @agent-org/server && npm run build -w @agent-org/web",
    "start": "node scripts/start.mjs",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint -w @agent-org/web"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=20"
  }
}
