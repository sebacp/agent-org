# Copiá este archivo a `.env` y pegá tu key de https://platform.deepseek.com
# Solo se usa en el servidor: nunca llega al navegador.
DEEPSEEK_API_KEY=

# Opcional, de https://platform.openai.com: hace que buscar en la biblioteca
# entienda lo que se le pregunta y no solo las palabras exactas. Sin esta key
# la búsqueda sigue andando, pero solo encuentra lo que dice lo mismo.
OPENAI_API_KEY=

# Opcional. El puerto que se abre, que es uno solo.
# PORT=3100

# Opcional. A dónde vuelve el navegador después de autorizar una fuente. Sin
# esto se toma del pedido que abrió el permiso, que está bien en una máquina
# sola y no alcanza detrás de un proxy que termina TLS con otro nombre.
# APP_ORIGIN=https://agentes.tuempresa.com

# Opcional. Dónde se guarda todo lo de la empresa. Por defecto es `.data` al
# lado de este archivo; en la imagen es un volumen y no hay nada que tocar.
# DATA_DIR=/var/lib/agent-org
