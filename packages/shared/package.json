{
  "name": "@agent-org/shared",
  "version": "0.1.0",
  "private": true,
  "exports": {
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@xyflow/react": "^12.11.2",
    "typescript": "^5"
  }
}
